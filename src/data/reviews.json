  {
    "id": 6,
    "documentId": "cssq5uwup4hn2uebnyjgsbyl",
    "name": "Cody Alexanger",
    "description": [
      {
        "type": "paragraph",
        "children": [
          {
            "text": "\"We hired SCG Services to handle some much-needed repairs on a house and install smart Wi-Fi-controlled lighting, and they did an amazing job! Their team was professional, efficient, and detail-oriented, ensuring every repair was done with precision.",
            "type": "text"
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "text": "The new Wi-Fi-enabled lights are a game-changer! Now, we can easily adjust the brightness and ambiance with just a tap on our phones, making the space more functional and modern.",
            "type": "text"
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "text": "We highly recommend SCG Services for their expertise, reliability, and top-quality workmanship. Thank you for exceeding our expectations!\"",
            "type": "text"
          }
        ]
      }
    ],
