  {
    "id": 5,
    "documentId": "m9kxuhuq5f32c5dq8cmo1oir",
    "name": "Cielo Mexico Grill & Cantina",
    "description": [
      {
        "type": "paragraph",
        "children": [
          {
            "text": "\"We recently hired SCG Services to pressure wash our restaurant's driveway, and we couldn’t be happier with the results! The team was professional, punctual, and thorough, removing years of built-up dirt, grease, and stains. Our driveway looks like new, creating a much cleaner and more welcoming entrance for our customers.",
            "type": "text"
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "text": "Their attention to detail and commitment to quality really stood out. We highly recommend SCG Services for anyone in need of top-notch pressure washing services. Thank you for the fantastic job!\"",
            "type": "text"
          }
        ]
      }
    ],
